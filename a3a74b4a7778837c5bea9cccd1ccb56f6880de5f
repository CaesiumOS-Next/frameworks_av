      "writtenOn": "2024-11-19T22:46:28Z",
      "side": 1,
      "message": "nit: This could be `Self::new()`, which would make the `AMediaFormat_delete` in line 338 unnecessary.",
      "range": {
        "startLine": 328,
        "startChar": 8,
        "endLine": 331,
        "endChar": 42
      },
      "revId": "a3a74b4a7778837c5bea9cccd1ccb56f6880de5f",
