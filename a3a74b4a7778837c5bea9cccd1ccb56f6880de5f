    {
      "unresolved": true,
      "key": {
        "uuid": "c834f345_9c008ac4",
        "filename": "media/ndk/mediacodec-rs-ndk/lib.rs",
        "patchSetId": 4
      },
      "lineNbr": 253,
      "author": {
        "id": 1291337
      },
      "writtenOn": "2024-11-19T23:03:19Z",
      "side": 1,
      "message": "Using a `const` to store `-libc::ENOMEM` will avoid the `n if n \u003d\u003d ...` construction.\n\nSee https://play.rust-lang.org/?version\u003dstable\u0026mode\u003ddebug\u0026edition\u003d2021\u0026gist\u003df0c7f074b7bde223b3c916295d4987b7",
      "range": {
