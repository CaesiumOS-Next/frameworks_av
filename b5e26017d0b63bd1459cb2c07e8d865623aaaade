      "writtenOn": "2025-02-07T07:49:33Z",
      "side": 1,
      "message": "This is to support the pcm offload, Eric suggested us that to support pcm offload we can have simply add pcm profiles in the compress mix ports, and this way any pcm played can leverage async path if clients can support async method for playback.",
      "parentUuid": "e214cf4a_02940d95",
      "range": {
        "startLine": 46,
        "startChar": 45,
        "endLine": 46,
        "endChar": 67
