      "writtenOn": "2024-11-21T16:35:10Z",
      "side": 1,
      "message": "We have used properties approach to provide feasibility to vendor\u0027s as all vendors may not use same notations and may use different lib/symbol names.\n\nThis properties can be defined and provided by vendor so that this fwk code remains intact and only those valuse can vary from vendor-vendor and some may not require/use this properties.",
      "parentUuid": "e14b42b4_3dd15042",
      "range": {
        "startLine": 56,
        "startChar": 0,
        "endLine": 56,
        "endChar": 94
      },
      "revId": "ca1e7c3006e4f7b98c7a6cae30c941c9900d03f1",
