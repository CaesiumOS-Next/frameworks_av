      "writtenOn": "2024-11-20T00:53:32Z",
      "side": 1,
      "message": "For consistency with other code, please call the registration function `createIHalAdapterVendorExtension` and make it return `binder_status_t` to indicate success in registration, please see a similar function for a reference:\n\nhttps://source.corp.google.com/h/googleplex-android/platform/superproject/main/+/main:hardware/interfaces/bluetooth/audio/aidl/default/service.cpp\n\nBy following this convention we can drop `ro.audio.ihaladaptervendorextension_symbol` property.\n\nAnd by having a result returned, there will be no need to check the service status with the service manager.",
      "range": {
        "startLine": 56,
        "startChar": 0,
        "endLine": 56,
        "endChar": 94
      },
      "revId": "ca1e7c3006e4f7b98c7a6cae30c941c9900d03f1",
