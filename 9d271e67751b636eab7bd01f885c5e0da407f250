ASSERT_NE(nullptr, mockCodec) \u003c\u003c \"MockCodec must not be null\";\n\n    codec-\u003ereleaseAsync(new AMessage);\n    // sleep here so that the looper thread can handle the error\n    std::this_thread::sleep_for(std::chrono::milliseconds(100));\n    looper-\u003estop();\n}\n"
