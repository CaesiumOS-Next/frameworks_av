package {
    default_applicable_licenses: ["frameworks_av_license"],
}

cc_library {
    name: "libcodec2_soft_iamfdec",
    defaults: [
        "libcodec2_soft-defaults",
        "libcodec2_soft_sanitize_all-defaults",
    ],
    srcs: [
        "C2SoftIamfDec.cpp",
        "LayoutTranslation.cpp",
    ],
    shared_libs: [
        "iamf_tools",
        "liblog",
    ],
    include_dirs: [
        "external/iamf_tools",
        "external/abseil-cpp",
    ],
}
