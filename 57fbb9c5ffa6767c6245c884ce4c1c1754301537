    },
    {
      "unresolved": false,
      "key": {
        "uuid": "2a68bf7b_93fee0b0",
        "filename": "media/libstagefright/rtsp/ARTPSource.cpp",
        "patchSetId": 5
      },
      "lineNbr": 92,
      "author": {
        "id": 4940726
